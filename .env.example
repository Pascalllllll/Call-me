# Copy to your process manager / systemd unit. Call-me does not read .env files itself.
NODE_ENV=production
HOST=127.0.0.1                 # keep on loopback; expose only through the HTTPS reverse proxy
PORT=3000
ALLOWED_ORIGINS=https://call.example.com
DB_PATH=/var/lib/callme/callme.db
TRUST_PROXY=1                  # only when a reverse proxy sets X-Forwarded-For
# STUN servers as JSON (default: Google STUN)
# ICE_SERVERS=[{"urls":["stun:stun.l.google.com:19302"]}]
# coturn with use-auth-secret: clients get 12h HMAC credentials, never the secret
# TURN_URLS=turns:turn.example.com:5349,turn:turn.example.com:3478
# TURN_SECRET=change-me-to-a-long-random-string
